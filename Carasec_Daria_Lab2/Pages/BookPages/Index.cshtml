@page
@model Carasec_Daria_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-page="./Create">Create New</a>
</p>

<form method="get">
    <div class="form-group">
        <label asp-for="AuthorID">Author</label>
        <select asp-for="AuthorID"
                asp-items="Model.Authors"
                class="form-control">
            <option value="">All Authors</option>
        </select>
    </div>

    <p>
        <input type="submit" value="Filter" />
        <a asp-page="./Index">Reset</a>
    </p>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Publishing Date</th>
            <th>Publisher</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Book)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @if (item.Author != null)
                    {
                        @($"{item.Author.FirstName} {item.Author.LastName}")
                    }
                    else
                    {
                        <span>No author assigned</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>
                <td>
                    @item.Publisher?.PublisherName
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
